APP_NAME=SMPilot AI
APP_ENV=development
APP_DEBUG=false
APP_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://smpilot:smpilot@localhost/smpilot
SESSION_SECRET=replace-with-a-long-random-value
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional direct OpenAI fallback configuration:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
