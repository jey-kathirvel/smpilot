[Unit]
Description=SMPilot AI FastAPI application
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=smpilot
Group=smpilot
WorkingDirectory=/opt/smpilot
EnvironmentFile=/opt/smpilot/.env
ExecStart=/opt/smpilot/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8130 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/smpilot

[Install]
WantedBy=multi-user.target
